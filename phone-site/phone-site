    if (!docId || !r.ok) {
      const body = `--${boundary}\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n${JSON.stringify({ name: "My DeviantArt Library", mimeType: "application/vnd.google-apps.document" })}\r\n--${boundary}\r\nContent-Type: text/html; charset=UTF-8\r\n\r\n${html}\r\n--${boundary}--`;
      r = await fetch("https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id", {
        method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "multipart/related; boundary=" + boundary }, body
      });
    }
    const j = await r.json().catch(() => ({}));
    if (!r.ok) {
      const msg = (j.error && j.error.message) || "HTTP " + r.status;
      if (/has not been used|is disabled|accessNotConfigured/i.test(msg)) {
        const url = `https://console.cloud.google.com/apis/library/drive.googleapis.com?project=${encodeURIComponent(cfg.projectId)}`;
        B.notice = `To make Google Docs, turn on the Google Drive API once: <a href="${url}" target="_blank" rel="noopener">open this page</a> → <b>Enable</b>, wait a minute, then try again.`;
        emit();
        throw new Error("Turn on the Google Drive API first (see the note at the top)");
      }
      throw new Error("Google Doc failed: " + msg);
    }
    const id = j.id || docId;
    if (id !== meta.gdocId) {
      meta = Object.assign({}, meta, { gdocId: id });
      await runOps([["set", col, "meta", Object.assign({}, meta, { categories: B.lib.categories, categoriesAt: B.lib.categoriesAt, deleted: B.lib.deleted })]]).catch(() => {});
    }
    const url = "https://docs.google.com/document/d/" + id + "/edit";
    B.notice = `Your Google Doc is ready: <a href="${url}" target="_blank" rel="noopener">open My DeviantArt Library</a>`;
    emit();
    const a = document.createElement("a"); a.href = url; a.target = "_blank"; a.rel = "noopener"; a.click();
  }

  B.menu = {
    gdoc: { label: "Make / update Google Doc", sub: "Every link, grouped by category, in your Google Drive", icon: "doc", run: () => makeDoc().catch((e) => B.toast(e.message || String(e), true)) },
    switch: { label: "Switch Google account", sub: "", icon: "refresh", run: async () => { await B.signOut(); B.signIn(); } },
    signout: { label: "Sign out", sub: "", icon: "home", run: () => B.signOut() }
  };

  B.emptyHtml = () => {
    if (B.mode === "loading") return `<div class="empty"><h2>Loading your Library…</h2></div>`;
    if (B.mode === "setup") return `<div class="empty"><h2>Almost there</h2><p>Open this page with the <b>phone link</b> from the Better DeviantArt extension on your computer (<b>Library → Google account</b> — scan the QR code), so it knows which account to use. After that, this page remembers it.</p></div>`;
    if (B.mode === "signin") return `<div class="empty signin"><h2>Your DeviantArt Library</h2><p>Sign in with the Google account you use with Better DeviantArt.</p>
      <button class="gbtn" data-signin><svg viewBox="0 0 48 48" width="20" height="20"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C36.9 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>Sign in with Google</button>
      <p class="muted">${esc(B.status && B.mode === "signin" && !/^Sign in with Google/.test(B.status) ? B.status : "")}</p></div>`;
    return `<div class="empty"><h2>Your Library is empty</h2>
      <p>On your computer, open Better DeviantArt → <b>Library → Google account</b> and sign in with this same Google account. Everything you've saved appears here, and new saves show up automatically.</p>
      <p>You can also tap <b>+</b> to add your own images.</p></div>`;
  };

  document.addEventListener("click", (e) => {
    if (!e.target.closest) return;
    if (e.target.closest("[data-signin]")) { e.preventDefault(); B.signIn(); }
    else if (e.target.closest("[data-makedoc]")) { e.preventDefault(); B.notice = ""; emit(); makeDoc().catch((er) => B.toast(er.message || String(er), true)); }
  });

  init().catch((e) => { B.mode = "signin"; B.status = (e && e.message) || String(e); B.badge = "error"; B.toast(B.status, true); emit(); });
})();

</script>
<script>
// Better DeviantArt — Library web app (phone / tablet / any browser).
// Runs inside the Google Apps Script page (mode "edit" or "view") or as an exported offline file ("offline").
(function () {
  const BOOT = window.BDA_BOOT || { mode: "offline", library: { items: {}, categories: [] } };
  // A backend can be supplied by the host page (the Claude cloud library sets window.BDA_BACKEND).
  const EXT = window.BDA_BACKEND || null;
  let MODE = EXT ? EXT.mode : BOOT.mode;
  let CAN_EDIT = EXT ? !!EXT.canEdit : MODE === "edit";
  const HAS_SERVER = !EXT && (MODE === "edit" || MODE === "view") && !!(window.google && google.script && google.script.run);
  const $ = (s) => document.querySelector(s);

  let lib = norm(EXT ? EXT.lib : BOOT.library);
  let docUrl = BOOT.docUrl || "";
  let lastFetch = Date.now();

  const store = {
    get(k, d) { try { const v = localStorage.getItem("bdaw." + k); return v == null ? d : JSON.parse(v); } catch (e) { return d; } },
    set(k, v) { try { localStorage.setItem("bdaw." + k, JSON.stringify(v)); } catch (e) {} }
  };
  const state = {
    view: store.get("view", "auto"),
    sort: store.get("sort", "new"),
    col: store.get("col", window.innerWidth < 500 ? 150 : 210),
    filter: null,
    q: "",
    selecting: false,
    selected: new Set(),
    order: new Map()
  };
  document.documentElement.style.setProperty("--col", state.col + "px");

  function norm(l) {
    l = l || {};
    return { items: l.items || {}, categories: Array.isArray(l.categories) ? l.categories : [], categoriesAt: l.categoriesAt || 0, deleted: l.deleted || {} };
  }

  const ICON = {
    more: '<circle cx="5" cy="12" r="1.6" class="f"/><circle cx="12" cy="12" r="1.6" class="f"/><circle cx="19" cy="12" r="1.6" class="f"/>',
    check: '<path d="M5 12l5 5L20 7"/>',
    play: '<path d="M8 5v14l11-7z" class="f"/>',
    open: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"/>',
    refresh: '<path d="M20 11a8 8 0 10-2.3 5.7"/><path d="M20 4v7h-7"/>',
    select: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 12l3 3 5-6"/>',
    tag: '<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
    doc: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/>',
    size: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
    home: '<path d="M3 11l9-8 9 8M5 10v10h14V10"/>',
    trash: '<path d="M5 7h14M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>'
  };
  const svg = (n) => `<svg viewBox="0 0 24 24">${ICON[n]}</svg>`;
  const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  let toastT;
  function toast(text, isErr) {
    if (window.BDA_VIEWER && BDA_VIEWER.isOpen()) return BDA_VIEWER.toast(text, isErr);
    const t = $("#toast");
    t.textContent = text;
    t.classList.toggle("err", !!isErr);
    t.classList.add("show");
    clearTimeout(toastT);
    toastT = setTimeout(() => t.classList.remove("show"), isErr ? 4000 : 2000);
  }

  function server(fn, ...args) {
    return new Promise((resolve, reject) => {
      if (!HAS_SERVER) return reject(new Error("This is an offline copy — it can't be changed"));
      google.script.run.withSuccessHandler(resolve).withFailureHandler((e) => reject(e instanceof Error ? e : new Error(String(e && e.message || e))))[fn](...args);
    });
  }

  // ---------------------------------------------------------------- data
  const items = () => Object.values(lib.items).filter((it) => it && it.url);
  const randKey = (id) => { if (!state.order.has(id)) state.order.set(id, Math.random()); return state.order.get(id); };
  const shuffled = (list) => list.slice().sort((a, b) => randKey(a.id) - randKey(b.id));
  const SORTS = {
    new: (a, b) => (b.savedAt || 0) - (a.savedAt || 0),
    old: (a, b) => (a.savedAt || 0) - (b.savedAt || 0),
    artist: (a, b) => (a.artist || "").localeCompare(b.artist || "", undefined, { sensitivity: "base" }) || SORTS.new(a, b),
    title: (a, b) => (a.title || "").localeCompare(b.title || "", undefined, { sensitivity: "base" })
  };
  const sorted = (list) => list.slice().sort(SORTS[state.sort] || SORTS.new);
  const TAGS = window.BDA_TAGS;
  const IMG = window.BDA_IMAGES;
  const inCategory = () => items().filter((it) => state.filter === null || (it.category || "") === state.filter);
  const filtered = () => inCategory().filter((it) => TAGS.matches(it, state.q));
  function toggleTag(tag) {
    const token = "#" + (tag.includes(" ") ? `"${tag}"` : tag);
    let parts = state.q.split(/\s+(?=(?:[^"]*"[^"]*")*[^"]*$)/).filter(Boolean);
    parts = parts.includes(token) ? parts.filter((p) => p !== token) : parts.concat(token);
    state.q = parts.join(" ");
    $("#q").value = state.q;
    if (state.q && $("#searchbar").hidden) { $("#searchbar").hidden = false; $("#searchBtn").classList.add("on"); }
    render();
  }
  const view = () => state.view !== "auto" ? state.view : (items().some((it) => it.category) ? "category" : "shuffle");

  // Same edit rules as the server, applied right away so taps feel instant.
  function applyOps(l, ops) {
    const t = Date.now();
    const cat = (name) => {
      name = String(name || "").trim().slice(0, 60);
      if (name && !l.categories.includes(name)) { l.categories.push(name); l.categoriesAt = t; }
      return name;
    };
    for (const op of ops) {
      const ids = [].concat(op.ids || op.id || []);
      if (op.op === "remove") ids.forEach((id) => { if (l.items[id]) { delete l.items[id]; l.deleted[id] = t; } });
      else if (op.op === "move") { const c = cat(op.category); ids.forEach((id) => { const it = l.items[id]; if (it) { it.category = c; it.updatedAt = t; } }); }
      else if (op.op === "edit") { const it = l.items[op.id]; if (it) { if (op.note != null) it.note = op.note; if (op.title) it.title = op.title; it.updatedAt = t; } }
      else if (op.op === "tags") { const it = l.items[op.id]; if (it) { it.tags = op.tags.slice(0, 30); it.updatedAt = t; } }
      else if (op.op === "addTags") ids.forEach((id) => { const it = l.items[id]; if (it) { const cur = (it.tags || []).slice(); op.tags.forEach((x) => { if (!cur.includes(x)) cur.push(x); }); it.tags = cur; it.updatedAt = t; } });
      else if (op.op === "addCategory") cat(op.name);
      else if (op.op === "renameCategory") {
        const to = String(op.to || "").trim();
        if (!to) continue;
        const i = l.categories.indexOf(op.from);
        if (l.categories.includes(to)) { if (i >= 0) l.categories.splice(i, 1); } else if (i >= 0) l.categories[i] = to;
        Object.values(l.items).forEach((it) => { if (it.category === op.from) { it.category = to; it.updatedAt = t; } });
      } else if (op.op === "deleteCategory") {
        l.categories = l.categories.filter((c) => c !== op.name);
        Object.values(l.items).forEach((it) => { if (it.category === op.name) { it.category = ""; it.updatedAt = t; } });
      }
    }
  }

  async function edit(ops, msg) {
    if (!CAN_EDIT) return toast("This link is view-only", true);
    applyOps(lib, ops);
    render();
    if (msg) toast(msg);
    if (EXT) {
      try { await EXT.commit(lib); } catch (e) { toast("Couldn't save: " + (e.message || e.code || e), true); }
      return;
    }
    try {
      const res = await server("apiEdit", BOOT.key, ops);
      if (res && res.library) { lib = norm(res.library); render(); }
    } catch (e) {
      toast("Couldn't save: " + e.message, true);
      refresh(true);
    }
  }

  async function refresh(quiet) {
    if (EXT) { if (EXT.refresh) await EXT.refresh(); if (!quiet) toast("Up to date"); return; }
    if (!HAS_SERVER) return quiet || toast("Offline copy — nothing to refresh");
    try {
      const res = await server("apiGet", BOOT.key);
      lib = norm(res.library);
      if (res.docUrl) docUrl = res.docUrl;
      lastFetch = Date.now();
      render();
      if (!quiet) toast("Up to date");
    } catch (e) { if (!quiet) toast("Refresh failed: " + e.message, true); }
  }

  // ---------------------------------------------------------------- render
  let visible = [];

  function renderChips() {
    const counts = { __all: 0 };
    for (const it of items()) { counts.__all++; counts[it.category || ""] = (counts[it.category || ""] || 0) + 1; }
    const el = $("#chips");
    el.textContent = "";
    const mk = (label, value, n) => {
      const b = document.createElement("button");
      b.className = "chip" + (state.filter === value ? " on" : "");
      b.innerHTML = `<span>${esc(label)}</span><i>${n || 0}</i>`;
      b.onclick = () => { state.filter = state.filter === value && value !== null ? null : value; render(); };
      el.appendChild(b);
    };
    mk("All", null, counts.__all);
    for (const c of lib.categories) if (counts[c]) mk(c, c, counts[c]);
    if (counts[""] && lib.categories.length) mk("Uncategorized", "", counts[""]);
    el.hidden = el.children.length < 2;
    const row = $("#tagrow");
    row.textContent = "";
    const active = state.q.toLowerCase().split(/\s+/);
    for (const [t, n] of TAGS.top(inCategory(), 30)) {
      const b = document.createElement("button");
      const token = "#" + (t.includes(" ") ? `"${t}"` : t);
      b.className = "tag" + (active.includes(token) ? " on" : "");
      b.innerHTML = `${esc(t)}<i>${n}</i>`;
      b.onclick = () => toggleTag(t);
      row.appendChild(b);
    }
  }

  function placeholder(it) {
    const letter = esc(((it.title || "?").trim()[0] || "?").toUpperCase());
    return "data:image/svg+xml;charset=utf-8," + encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="300" height="220"><rect width="300" height="220" fill="#182025"/><text x="150" y="132" font-family="system-ui,sans-serif" font-size="72" fill="#3c4a53" text-anchor="middle">${letter}</text></svg>`);
  }
  const thumbOf = (it) => (EXT && EXT.thumbOf ? EXT.thumbOf(it) : (it.thumb || it.img)) || placeholder(it);

  function tagChips(it) {
    const mine = (it.tags || []).map(TAGS.norm).filter(Boolean);
    const da = (it.daTags || []).map(TAGS.norm).filter((t) => t && !mine.includes(t));
    const show = mine.slice(0, 3).map((t) => [t, 1]).concat(da.slice(0, Math.max(0, 2 - mine.length)).map((t) => [t, 0]));
    return show.length ? `<div class="tags">${show.map(([t, m]) => `<button class="tag${m ? " mine" : ""}" data-tag="${esc(t)}">${esc(t)}</button>`).join("")}</div>` : "";
  }

  function card(it) {
    const el = document.createElement("div");
    el.className = "card" + (state.selected.has(it.id) ? " sel" : "");
    el.dataset.id = it.id;
    el.innerHTML = `<img loading="lazy" alt="" referrerpolicy="no-referrer">
      <div class="chk">${svg("check")}</div>
      <button class="more" aria-label="Options">${svg("more")}</button>
      <div class="info"><div class="t">${esc(it.title || "Untitled")}</div>
      <div class="a"><span>${it.artist ? "by " + esc(it.artist) : IMG.isUpload(it) ? "Your image" : it.remote ? "Image link" : ""}</span>${it.category && view() !== "category" ? `<span class="cat">${esc(it.category)}</span>` : ""}</div>${tagChips(it)}</div>`;
    const img = el.querySelector("img");
    img.src = thumbOf(it);
    img.onerror = () => {
      if (!EXT && it.img && img.src !== it.img) img.src = it.img;
      else if (EXT && EXT.fallbackThumb && !img.dataset.fb) {
        img.dataset.fb = "1";
        EXT.fallbackThumb(it).then((u) => { img.src = u || placeholder(it); });
      } else if (!/^data:image\/svg/.test(img.src)) img.src = placeholder(it);
    };
    return el;
  }

  function renderNotice() {
    if (!EXT) return;
    const b = $("#notice");
    if (!b) return;
    b.hidden = !EXT.notice;
    if (EXT.notice && b.dataset.html !== EXT.notice) {
      b.dataset.html = EXT.notice;
      b.innerHTML = `<span>${EXT.notice}</span><button aria-label="Dismiss">✕</button>`;
      b.querySelector('button[aria-label="Dismiss"]').onclick = () => { EXT.notice = ""; b.hidden = true; b.dataset.html = ""; };
    }
  }
  function render() {
    renderNotice();
    renderChips();
    const all = items();
    $("#count").innerHTML = `${all.length} saved${lib.categories.length ? " · " + lib.categories.length + " categories" : ""}` +
      (EXT ? (EXT.badge ? `<span class="ro${EXT.badgeOk ? " ok" : ""}">${esc(EXT.badge)}</span>` : "") : CAN_EDIT ? "" : '<span class="ro">' + (MODE === "offline" ? "offline copy" : "view only") + "</span>");
    $("#addBtn").hidden = !CAN_EDIT;
    document.querySelectorAll("#viewSeg button").forEach((b) => b.classList.toggle("on", b.dataset.v === state.view));
    $("#sort").value = state.sort;
    $("#sort").disabled = view() === "shuffle";
    const grid = $("#grid");
    grid.textContent = "";
    visible = [];
    const list = filtered();
    if (!all.length) {
      grid.innerHTML = EXT && EXT.emptyHtml ? EXT.emptyHtml() : `<div class="empty"><h2>Nothing saved yet</h2><p>Save deviations on your computer with Better DeviantArt (press S on a deviation). They'll show up here after the next sync.</p></div>`;
      return updateSel();
    }
    if (!list.length) { grid.innerHTML = `<div class="empty"><h2>Nothing matches</h2><p>Try another search or category.</p></div>`; return updateSel(); }

    const section = (title, arr) => {
      const sec = document.createElement("section");
      sec.className = "section";
      if (title != null) {
        const h = document.createElement("div");
        h.className = "section-h";
        h.innerHTML = `<h2>${esc(title)}</h2><span class="n">${arr.length}</span><button>${svg("play")}Play</button>`;
        h.querySelector("button").onclick = () => openViewer(shuffled(arr), 0, true);
        sec.appendChild(h);
      }
      const g = document.createElement("div");
      g.className = "masonry";
      for (const it of arr) { g.appendChild(card(it)); visible.push(it); }
      sec.appendChild(g);
      grid.appendChild(sec);
    };

    const v = view();
    if (v === "shuffle") section(null, shuffled(list));
    else if (v === "artist") {
      const by = new Map();
      for (const it of sorted(list)) { const k = it.artist || "Unknown artist"; if (!by.has(k)) by.set(k, []); by.get(k).push(it); }
      [...by.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0])).forEach(([k, arr]) => section(k, arr));
    } else {
      const groups = new Map();
      for (const c of lib.categories) groups.set(c, []);
      groups.set("", []);
      for (const it of list) { const k = it.category || ""; if (!groups.has(k)) groups.set(k, []); groups.get(k).push(it); }
      for (const [c, arr] of groups) if (arr.length) section(c || "Uncategorized", c ? sorted(arr) : (state.sort === "new" ? shuffled(arr) : sorted(arr)));
    }
    updateSel();
  }

  // ---------------------------------------------------------------- viewer
  function openViewer(list, index, autoplay) {
    if (!list.length || !window.BDA_VIEWER) return;
    const v = BDA_VIEWER.open({
      items: list.map((it) => {
        const up = IMG.isUpload(it);
        return {
          src: thumbOf(it), best: EXT || up ? undefined : it.img || undefined, title: it.title, artist: it.artist || (up ? "you" : ""),
          url: up ? "" : (it.remote ? it.img : it.url), id: it.id, lib: it,
          load: EXT ? () => EXT.loadFull(it) : up ? () => (it.driveId && HAS_SERVER ? server("apiImage", BOOT.key, it.driveId) : Promise.resolve(null)) : undefined
        };
      }),
      index: Math.max(0, index),
      prefs: { zoomMode: "fit", autoHideUI: true, backdropClose: false, slideshowSeconds: store.get("slide", 5), accent: getComputedStyle(document.documentElement).getPropertyValue("--accent").trim() || "#00e59b",
        noImageLink: !!EXT && !EXT.imageLink, downloadLabel: EXT ? "Save to device" : "Download" },
      actions: EXT ? (EXT.saveImage ? { download: (vi) => EXT.saveImage(vi.lib).then((m) => m && toast(m), (e) => toast(e.message || "Couldn't save", true)) } : {}) :
        { download: (it) => { if (/^data:/.test(it.best || "")) { const a = document.createElement("a"); a.href = it.best; a.download = (it.title || "image") + ".jpg"; a.click(); } else window.open(it.best || it.src, "_blank"); } }
    });
    if (autoplay && list.length > 1) v.togglePlay();
  }

  // ---------------------------------------------------------------- sheets
  function openSheet(html, setup) {
    $("#sheetBody").innerHTML = html;
    $("#sheet").hidden = false;
    $("#scrim").hidden = false;
    if (setup) setup($("#sheetBody"));
  }
  function closeSheet() { $("#sheet").hidden = true; $("#scrim").hidden = true; $("#sheetBody").innerHTML = ""; }
  $("#scrim").onclick = closeSheet;

  function ask(message, opts = {}) {
    return new Promise((resolve) => {
      openSheet(`<h3 style="font-size:16px;line-height:1.4">${esc(message)}</h3>
        ${opts.input ? `<input type="text" data-ask placeholder="${esc(opts.placeholder || "")}" maxlength="300" enterkeyhint="done" style="margin-top:12px">` : ""}
        <div class="row" style="margin-top:14px"><button class="pill ${opts.danger ? "danger-solid" : "accent"}" data-ok>${esc(opts.okLabel || "OK")}</button>${opts.noCancel ? "" : '<button class="pill" data-cancel>Cancel</button>'}</div>`, (body) => {
        const input = body.querySelector("[data-ask]");
        const done = (v) => { closeSheet(); resolve(v); };
        body.querySelector("[data-ok]").onclick = () => done(input ? input.value : true);
        const c = body.querySelector("[data-cancel]");
        if (c) c.onclick = () => done(null);
        if (input) { input.focus(); input.onkeydown = (e) => { if (e.key === "Enter") done(input.value); }; }
      });
    });
  }

  function categoryChips(current, withNew) {
    const names = [""].concat(lib.categories);
    return `<div class="row">${names.map((c) => `<button class="chip${(current || "") === c ? " cur" : ""}" data-cat="${esc(c)}">${esc(c || "Uncategorized")}</button>`).join("")}</div>` +
      (withNew ? `<input type="text" data-new placeholder="New category… then tap Enter" maxlength="60" enterkeyhint="done">` : "");
  }

  function itemSheet(it) {
    const ro = !CAN_EDIT;
    openSheet(`
      <img class="preview" src="${esc(thumbOf(it))}" alt="">
      <h3 style="margin-top:12px">${esc(it.title || "Untitled")}</h3>
      <div class="sub">${it.artist ? "by " + esc(it.artist) : IMG.isUpload(it) ? "Your image" : ""}${it.category ? " · " + esc(it.category) : ""}</div>
      <div class="row">
        ${IMG.isUpload(it) ? "" : `<a class="pill accent" href="${esc(it.remote ? it.img : it.url)}" target="_blank" rel="noopener" style="text-decoration:none">${it.remote ? "Open image link" : "Open on DeviantArt"}</a>`}
        <button class="pill${IMG.isUpload(it) ? " accent" : ""}" data-a="view">View</button>
        ${IMG.isUpload(it) || it.remote || (EXT && !EXT.imageLink) ? "" : `<a class="pill" href="${esc(it.img || it.thumb)}" target="_blank" rel="noopener" style="text-decoration:none">Full image</a>`}
      </div>
      ${ro ? (it.note ? `<div class="lbl">Note</div><div>${esc(it.note)}</div>` : "") + (TAGS.tagsOf(it).length ? `<div class="lbl">Tags</div><div class="row">${TAGS.tagsOf(it).map((t) => `<span class="tag">${esc(t)}</span>`).join("")}</div>` : "") : `
      <div class="lbl">Category</div>${categoryChips(it.category, true)}
      <div class="lbl">Quick tags</div><input type="text" data-tags value="${esc((it.tags || []).join(", "))}" placeholder="horse, fantasy, pose ref" maxlength="300" enterkeyhint="done">
      ${(it.daTags || []).length ? `<div class="row" style="margin-top:6px">${it.daTags.slice(0, 14).map((t) => `<button class="tag" data-addtag="${esc(t)}">+ ${esc(t)}</button>`).join("")}</div>` : ""}
      <div class="lbl">Note</div><textarea rows="2" maxlength="500" placeholder="Add a note…">${esc(it.note || "")}</textarea>
      <div class="row"><button class="pill accent" data-a="saveNote">Save tags &amp; note</button><span style="flex:1"></span><button class="pill danger" data-a="remove">${svg("trash")} Remove</button></div>`}
    `, (body) => {
      body.onclick = (e) => {
        const add = e.target.closest("[data-addtag]");
        if (add) {
          const input = body.querySelector("[data-tags]");
          const cur = TAGS.parse(input.value);
          if (!cur.includes(add.dataset.addtag)) cur.push(add.dataset.addtag);
          input.value = cur.join(", ");
          add.remove();
          return;
        }
        const chip = e.target.closest("[data-cat]");
        if (chip) { closeSheet(); return edit([{ op: "move", ids: [it.id], category: chip.dataset.cat }], `Moved to ${chip.dataset.cat || "Uncategorized"}`); }
        const a = e.target.closest("[data-a]");
        if (!a) return;
        if (a.dataset.a === "view") { closeSheet(); openViewer(visible, visible.findIndex((x) => x.id === it.id)); }
        else if (a.dataset.a === "saveNote") {
          const note = body.querySelector("textarea").value.trim();
          const tags = TAGS.parse(body.querySelector("[data-tags]").value);
          closeSheet();
          edit([{ op: "edit", id: it.id, note }, { op: "tags", id: it.id, tags }], "Saved");
        }
        else if (a.dataset.a === "remove") ask(`Remove “${it.title}” from your Library?`, { okLabel: "Remove", danger: true }).then((ok) => ok && edit([{ op: "remove", ids: [it.id] }], "Removed"));
      };
      const nw = body.querySelector("[data-new]");
      if (nw) nw.onkeydown = (e) => { if (e.key === "Enter" && nw.value.trim()) { const c = nw.value.trim(); closeSheet(); edit([{ op: "move", ids: [it.id], category: c }], `Moved to ${c}`); } };
      const tg = body.querySelector("[data-tags]");
      if (tg) tg.onkeydown = (e) => { if (e.key === "Enter") body.querySelector('[data-a="saveNote"]').click(); };
    });
  }

  function moveSheet(ids) {
    openSheet(`<h3>Move ${ids.length} to…</h3><div class="sub">Pick a category or make a new one</div>${categoryChips(null, true)}`, (body) => {
      body.onclick = (e) => {
        const chip = e.target.closest("[data-cat]");
        if (!chip) return;
        closeSheet(); exitSelect();
        edit([{ op: "move", ids, category: chip.dataset.cat }], `Moved ${ids.length} to ${chip.dataset.cat || "Uncategorized"}`);
      };
      const nw = body.querySelector("[data-new]");
      nw.onkeydown = (e) => { if (e.key === "Enter" && nw.value.trim()) { closeSheet(); exitSelect(); edit([{ op: "move", ids, category: nw.value.trim() }], `Moved ${ids.length} to ${nw.value.trim()}`); } };
    });
  }

  function categoriesSheet() {
    const counts = {};
    for (const it of items()) counts[it.category || ""] = (counts[it.category || ""] || 0) + 1;
    openSheet(`<h3>Categories</h3><div class="sub">Rename or delete. Deleting keeps the deviations (as Uncategorized).</div>
      ${lib.categories.map((c) => `<div class="cat-row" data-c="${esc(c)}"><input type="text" value="${esc(c)}" maxlength="60"><span class="n">${counts[c] || 0}</span><button class="pill danger" data-del>${svg("trash")}</button></div>`).join("") || '<p class="sub">No categories yet.</p>'}
      <div class="cat-row"><input type="text" data-add placeholder="New category" maxlength="60"><button class="pill accent" data-addbtn>Add</button></div>`, (body) => {
      body.querySelectorAll(".cat-row[data-c]").forEach((row) => {
        const from = row.dataset.c;
        row.querySelector("input").onchange = (e) => { const to = e.target.value.trim(); if (to && to !== from) edit([{ op: "renameCategory", from, to }], "Renamed"); };
        row.querySelector("[data-del]").onclick = () => ask(`Delete category “${from}”? Its deviations become Uncategorized.`, { okLabel: "Delete", danger: true }).then((ok) => ok && edit([{ op: "deleteCategory", name: from }], "Category deleted"));
      });
      const add = () => { const v = body.querySelector("[data-add]").value.trim(); if (v) { edit([{ op: "addCategory", name: v }], "Category added"); closeSheet(); } };
      body.querySelector("[data-addbtn]").onclick = add;
      body.querySelector("[data-add]").onkeydown = (e) => { if (e.key === "Enter") add(); };
    });
  }

  function menuSheet() {
    const opts = [];
    if (HAS_SERVER || (EXT && EXT.refresh)) opts.push(["refresh", "refresh", "Refresh", "Get the latest from your computer"]);
    if (CAN_EDIT) opts.push(["add", "size", "Add your own images", "From your photos or files"]);
    opts.push(["select", "select", "Select several", "Move or remove many at once"]);
    if (CAN_EDIT) opts.push(["cats", "tag", "Manage categories", ""]);
    opts.push(["size", "size", "Thumbnail size", ["Small", "Medium", "Large"][state.col <= 130 ? 0 : state.col <= 190 ? 1 : 2]]);
    opts.push(["slide", "play", "Slideshow speed", store.get("slide", 5) + " seconds"]);
    if (CAN_EDIT && docUrl) opts.push(["doc", "doc", "Open Google Doc", "Every link, grouped by category"]);
    opts.push(["home", "home", "Add to Home Screen", "Open this like an app"]);
    if (EXT && EXT.menu) for (const k in EXT.menu) opts.push([k, EXT.menu[k].icon || "refresh", EXT.menu[k].label, EXT.menu[k].sub || ""]);
    openSheet(`<h3>My Library</h3><div class="sub">${EXT ? esc(EXT.status || "") : MODE === "edit" ? "Private link — changes sync to your computer" : MODE === "view" ? "Read-only link" : "Offline copy"}</div>
      <div class="menu-list">${opts.map(([k, ic, t, s]) => `<button data-m="${k}">${svg(ic)}<span>${t}${s ? `<small>${esc(s)}</small>` : ""}</span></button>`).join("")}</div>`, (body) => {
      body.onclick = (e) => {
        const b = e.target.closest("[data-m]");
        if (!b) return;
        const m = b.dataset.m;
        if (m === "refresh") { closeSheet(); refresh(); }
        else if (m === "select") { closeSheet(); enterSelect(); }
        else if (m === "add") { closeSheet(); $("#addFile").click(); }
        else if (m === "cats") categoriesSheet();
        else if (m === "size") {
          state.col = state.col <= 130 ? 165 : state.col <= 190 ? 250 : 115;
          store.set("col", state.col);
          document.documentElement.style.setProperty("--col", state.col + "px");
          menuSheet();
        } else if (m === "slide") {
          const cur = store.get("slide", 5), opts2 = [3, 5, 8, 12];
          store.set("slide", opts2[(opts2.indexOf(cur) + 1) % opts2.length]);
          menuSheet();
        } else if (m === "doc") { const a = document.createElement("a"); a.href = docUrl; a.target = "_blank"; a.rel = "noopener"; a.click(); }
        else if (m === "home") {
          const ios = /iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
          ask(EXT && EXT.kind === "artifact" ? "In the Claude app, open this page and use Share → Add to Home Screen (or bookmark it in your browser). It always opens your latest Library." :
            ios ? "Tap the Share button in Safari, then “Add to Home Screen”." : "Open your browser menu (⋮) and choose “Add to Home screen” or “Install app”.", { okLabel: "Got it", noCancel: true });
        } else if (EXT && EXT.menu && EXT.menu[m]) { closeSheet(); EXT.menu[m].run(); }
      };
    });
  }

  // ---------------------------------------------------------------- selection
  function enterSelect(id) {
    state.selecting = true;
    document.body.classList.add("selecting");
    if (id) state.selected.add(id);
    render();
  }
  function exitSelect() {
    state.selecting = false;
    state.selected.clear();
    document.body.classList.remove("selecting");
    render();
  }
  function updateSel() {
    $("#selbar").hidden = !state.selecting;
    $("#selN").textContent = `${state.selected.size} selected`;
    $("#selMove").hidden = !CAN_EDIT;
    $("#selRemove").hidden = !CAN_EDIT;
    $("#selTag").hidden = !CAN_EDIT;
  }
  $("#selCancel").onclick = exitSelect;
  $("#selMove").onclick = () => state.selected.size && moveSheet([...state.selected]);
  $("#selView").onclick = () => state.selected.size && openViewer(visible.filter((it) => state.selected.has(it.id)), 0);
  $("#selTag").onclick = () => {
    const ids = [...state.selected];
    if (!ids.length) return;
    ask(`Add quick tags to ${ids.length}`, { input: true, placeholder: "horse, favourite", okLabel: "Add tags" }).then((v) => {
      const tags = TAGS.parse(v || "");
      if (tags.length) { exitSelect(); edit([{ op: "addTags", ids, tags }], `Tagged ${ids.length}`); }
    });
  };
  $("#selRemove").onclick = () => {
    const ids = [...state.selected];
    if (ids.length) ask(`Remove ${ids.length} from your Library?`, { okLabel: "Remove", danger: true }).then((ok) => { if (ok) { exitSelect(); edit([{ op: "remove", ids }], `Removed ${ids.length}`); } });
  };

  // ---------------------------------------------------------------- add your own images (phone/tablet)
  async function addImages(files) {
    if (!CAN_EDIT) return toast("This link is view-only", true);
    files = files.filter((f) => /^image\//.test(f.type || ""));
    if (!files.length) return;
    let ok = 0;
    for (let i = 0; i < files.length; i++) {
      toast(`Adding ${i + 1} of ${files.length}…`);
      try {
        const out = await IMG.prepare(files[i]);
        if (EXT) {
          await EXT.upload({ out, category: state.filter || "", tags: [] });
          ok++;
          continue;
        }
        const data = await IMG.blobToBase64(out.full);
        const res = await server("apiUpload", BOOT.key, {
          name: out.name, mime: out.mime, data, thumb: out.thumb, w: out.w, h: out.h,
          category: state.filter || "", tags: []
        });
        if (res && res.library) { lib = norm(res.library); render(); }
        ok++;
      } catch (e) { toast("Couldn't add " + (files[i].name || "image") + ": " + e.message, true); }
    }
    if (ok) toast(`Added ${ok} image${ok === 1 ? "" : "s"}${state.filter ? " to " + state.filter : ""}`);
  }
  $("#addBtn").hidden = !CAN_EDIT;
  $("#addBtn").onclick = () => $("#addFile").click();
  $("#addFile").onchange = (e) => { const f = [...e.target.files]; e.target.value = ""; addImages(f); };
  document.addEventListener("paste", (e) => {
    if (!CAN_EDIT || (e.target && e.target.matches && e.target.matches("input, textarea"))) return;
    const files = [...(e.clipboardData && e.clipboardData.files || [])];
    if (files.length) { e.preventDefault(); addImages(files); }
  });

  // ---------------------------------------------------------------- events
  $("#grid").addEventListener("click", (e) => {
    const tg = e.target.closest("[data-tag]");
    if (tg && !state.selecting) return toggleTag(tg.dataset.tag);
    const el = e.target.closest(".card");
    if (!el) return;
    const it = lib.items[el.dataset.id];
    if (!it) return;
    if (state.selecting) {
      state.selected.has(it.id) ? state.selected.delete(it.id) : state.selected.add(it.id);
      el.classList.toggle("sel", state.selected.has(it.id));
      return updateSel();
    }
    if (e.target.closest(".more")) return itemSheet(it);
    openViewer(visible, visible.findIndex((x) => x.id === it.id));
  });
  // Long-press a card to start selecting.
  $("#grid").addEventListener("contextmenu", (e) => {
    const el = e.target.closest(".card");
    if (!el) return;
    e.preventDefault();
    if (!state.selecting) enterSelect(el.dataset.id);
  });

  $("#viewSeg").onclick = (e) => {
    const b = e.target.closest("button");
    if (!b) return;
    if (b.dataset.v === "shuffle" && state.view === "shuffle") state.order.clear();
    state.view = b.dataset.v;
    store.set("view", state.view);
    render();
  };
  $("#sort").onchange = (e) => { state.sort = e.target.value; store.set("sort", state.sort); render(); };
  $("#searchBtn").onclick = () => {
    const bar = $("#searchbar");
    bar.hidden = !bar.hidden;
    $("#searchBtn").classList.toggle("on", !bar.hidden);
    if (!bar.hidden) $("#q").focus(); else if (state.q) { state.q = ""; $("#q").value = ""; render(); }
  };
  let qT;
  $("#q").oninput = (e) => { clearTimeout(qT); qT = setTimeout(() => { state.q = e.target.value.trim(); render(); }, 150); };
  $("#randomBtn").onclick = () => {
    const list = filtered();
    if (!list.length) return toast("Nothing to pick from", true);
    const pick = list[Math.floor(Math.random() * list.length)];
    openViewer(shuffled(list).sort((a, b) => (a.id === pick.id ? -1 : b.id === pick.id ? 1 : 0)), 0);
  };
  $("#playBtn").onclick = () => openViewer(shuffled(filtered()), 0, true);
  $("#menuBtn").onclick = menuSheet;

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible" && HAS_SERVER && Date.now() - lastFetch > 60000) refresh(true);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !$("#sheet").hidden) closeSheet();
  });

  // First-visit tip
  if (!store.get("tipSeen", false) && MODE !== "offline" && /mobi|android|iphone|ipad/i.test(navigator.userAgent)) {
    const b = $("#banner");
    b.innerHTML = EXT && EXT.kind === "artifact" ? `<span>Tip: bookmark this page, or add it to your Home Screen from your browser's Share menu, to open your Library in one tap.</span><button>Got it</button>`
      : `<span>Tip: add this page to your Home Screen to open your Library like an app.</span><button>Got it</button>`;
    b.hidden = false;
    b.querySelector("button").onclick = () => { b.hidden = true; store.set("tipSeen", true); };
  }

  if (EXT) {
    EXT.onUpdate(() => {
      MODE = EXT.mode;
      CAN_EDIT = !!EXT.canEdit;
      lib = norm(EXT.lib);
      for (const id of [...state.selected]) if (!lib.items[id]) state.selected.delete(id);
      if (!$("#sheet").hidden && $("#sheetBody").querySelector("[data-ask]")) return; // don't disturb typing
      render();
    });
    EXT.toast = toast;
  }
  render();
})();

</script>
</body>
</html>
