  </div>
</header>
<div class="searchbar" id="searchbar" hidden><input type="search" id="q" placeholder="Search or type a tag… e.g. horse" autocomplete="off"></div>
<nav class="chips" id="chips"></nav>
<nav class="chips tagrow" id="tagrow"></nav>
<div class="viewbar">
  <div class="seg" id="viewSeg">
    <button data-v="auto">Auto</button><button data-v="shuffle">Shuffle</button><button data-v="category">Categories</button><button data-v="artist">Artists</button>
  </div>
  <select id="sort" aria-label="Sort">
    <option value="new">Newest</option><option value="old">Oldest</option><option value="artist">Artist A–Z</option><option value="title">Title A–Z</option>
  </select>
</div>
<div class="banner" id="notice" hidden></div>
<div class="banner" id="banner" hidden></div>
<main id="grid"></main>

