  <b id="selN">0 selected</b>
  <button class="pill" id="selMove">Move</button>
  <button class="pill" id="selTag">Tag</button>
  <button class="pill" id="selView">View</button>
  <button class="pill danger" id="selRemove">Remove</button>
  <button class="pill" id="selCancel">Done</button>
</div>

<div class="scrim" id="scrim" hidden></div>
<div class="sheet" id="sheet" hidden role="dialog" aria-modal="true">
  <div class="grab"></div>
  <div id="sheetBody"></div>
</div>
<div class="toast" id="toast"></div>
<input type="file" id="addFile" accept="image/*" multiple hidden>
