<base target="_blank">
<title>My DeviantArt Library</title>
<style>
:root {
  --accent: #00e59b;
  --bg: #0b0f12;
  --panel: #12181c;
  --card: #182025;
  --line: #263038;
  --text: #e8eef1;
  --muted: #8d9aa3;
  --danger: #ff6b78;
  --col: 165px;
  --safe-b: env(safe-area-inset-bottom, 0px);
}
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
[hidden] { display: none !important; }
html { color-scheme: dark; }
body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; min-height: 100vh; overscroll-behavior-y: contain; }
svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
svg .f { fill: currentColor; stroke: none; }
button { font: inherit; color: inherit; }

.top {
  position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 8px;
  padding: calc(10px + env(safe-area-inset-top, 0px)) 14px 10px; background: color-mix(in srgb, var(--bg) 90%, transparent);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line);
}
.brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
.logo { position: relative; width: 34px; height: 34px; border-radius: 10px; background: #11161a; border: 2px solid var(--accent); color: var(--accent);
  font-weight: 800; display: flex; align-items: center; justify-content: center; font-size: 18px; flex: none; }
.logo span { position: absolute; top: -2px; right: 1px; font-size: 10px; color: #fff; }
.bt { min-width: 0; }
.bt h1 { margin: 0; font-size: 17px; line-height: 1.1; }
.bt span { color: var(--muted); font-size: 12px; white-space: nowrap; }
.tools { display: flex; gap: 4px; }
.ib { width: 40px; height: 40px; border-radius: 12px; border: 1px solid var(--line); background: var(--panel); display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; }
.ib:active { transform: scale(.95); }
.ib.on { border-color: var(--accent); color: var(--accent); }

.searchbar { padding: 10px 14px 0; }
.searchbar input { width: 100%; background: var(--panel); color: var(--text); border: 1px solid var(--line); border-radius: 12px; padding: 11px 14px; font-size: 16px; }
.searchbar input:focus { outline: none; border-color: var(--accent); }

.chips { display: flex; gap: 6px; overflow-x: auto; padding: 10px 14px 4px; scrollbar-width: none; }
.chips::-webkit-scrollbar { display: none; }
.chip { flex: none; display: inline-flex; align-items: center; gap: 6px; background: var(--panel); border: 1px solid var(--line); border-radius: 999px; padding: 7px 13px; font-size: 14px; cursor: pointer; white-space: nowrap; }
.chip i { font-style: normal; color: var(--muted); font-size: 12px; }
.chip.on { background: var(--accent); border-color: var(--accent); color: #07110d; font-weight: 650; }
.chip.on i { color: #07110d; opacity: .7; }

.tagrow { padding-top: 4px; }
.tagrow:empty { display: none; }
.tag { flex: none; background: none; border: 1px solid var(--line); color: #b9c4ca; border-radius: 999px; padding: 4px 10px; font-size: 13px; cursor: pointer; white-space: nowrap; }
.tag i { font-style: normal; color: var(--muted); font-size: 11px; margin-left: 3px; }
.tag.on { background: color-mix(in srgb, var(--accent) 25%, transparent); border-color: var(--accent); color: var(--text); }
.tag.mine { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); color: var(--text); }
.card .tags { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 5px; }
.card .tags .tag { padding: 1px 7px; font-size: 11px; }
.viewbar { display: flex; gap: 8px; padding: 8px 14px 2px; align-items: center; }
.seg { display: flex; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 3px; gap: 2px; flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; }
.seg button { flex: 1; background: none; border: 0; color: var(--muted); font-size: 13px; padding: 7px 8px; border-radius: 7px; cursor: pointer; white-space: nowrap; }
.seg button.on { background: var(--card); color: var(--text); box-shadow: inset 0 0 0 1px var(--accent); }
.viewbar select { background: var(--panel); color: var(--text); border: 1px solid var(--line); border-radius: 10px; padding: 8px; font-size: 13px; }

.banner { margin: 10px 14px 0; padding: 10px 12px; border-radius: 12px; background: var(--panel); border: 1px solid var(--line); font-size: 13px; color: #c9d3d8; display: flex; gap: 10px; align-items: center; }
.banner button { margin-left: auto; background: none; border: 0; color: var(--accent); font-weight: 600; cursor: pointer; flex: none; }

main { padding: 10px 14px calc(90px + var(--safe-b)); }
.section { margin-bottom: 22px; }
.section-h { display: flex; align-items: baseline; gap: 8px; margin: 8px 2px 10px; }
.section-h h2 { margin: 0; font-size: 17px; }
.section-h .n { color: var(--muted); font-size: 13px; }
.section-h button { margin-left: auto; background: var(--panel); border: 1px solid var(--line); border-radius: 999px; padding: 5px 11px; font-size: 13px; cursor: pointer; display: flex; gap: 5px; align-items: center; }
.section-h button svg { width: 14px; height: 14px; }
.masonry { columns: var(--col); column-gap: 10px; }
.card { position: relative; break-inside: avoid; margin: 0 0 10px; border-radius: 12px; overflow: hidden; background: var(--card); border: 1px solid var(--line); cursor: pointer; }
.card img { display: block; width: 100%; height: auto; min-height: 70px; background: #151b1f; }
.card .info { padding: 7px 9px 8px; }
.card .t { font-weight: 600; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.card .a { color: var(--muted); font-size: 12px; display: flex; gap: 6px; align-items: center; min-width: 0; }
.card .a span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.card .cat { margin-left: auto; background: #222c33; border-radius: 999px; padding: 1px 7px; font-size: 11px; color: #c9d3d8; white-space: nowrap; max-width: 50%; overflow: hidden; text-overflow: ellipsis; flex: none; }
.card .more { position: absolute; top: 6px; right: 6px; width: 32px; height: 32px; border-radius: 10px; background: rgba(10,14,17,.72); border: 1px solid rgba(255,255,255,.14); color: #fff; display: flex; align-items: center; justify-content: center; padding: 0; cursor: pointer; }
.card .more svg { width: 18px; height: 18px; }
.card .chk { position: absolute; top: 6px; left: 6px; width: 26px; height: 26px; border-radius: 8px; border: 2px solid #fff; background: rgba(0,0,0,.35); display: none; align-items: center; justify-content: center; color: #07110d; }
body.selecting .card .chk { display: flex; }
.card.sel { box-shadow: 0 0 0 3px var(--accent); border-color: var(--accent); }
.card.sel .chk { background: var(--accent); border-color: var(--accent); }
.card .chk svg { width: 16px; height: 16px; stroke-width: 3; }
.empty { text-align: center; color: var(--muted); padding: 70px 20px; }
.empty h2 { color: var(--text); }

.selbar { position: fixed; left: 10px; right: 10px; bottom: calc(10px + var(--safe-b)); z-index: 30; display: flex; gap: 6px; align-items: center; flex-wrap: wrap;
  background: var(--panel); border: 1px solid var(--accent); border-radius: 14px; padding: 8px 10px; box-shadow: 0 10px 30px rgba(0,0,0,.5); }
.selbar b { margin-right: auto; font-size: 14px; }
.pill { background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 7px 12px; font-size: 13.5px; cursor: pointer; }
.pill.accent { background: var(--accent); color: #07110d; border-color: var(--accent); font-weight: 650; }
.pill.danger { color: #ffb3ba; }
.pill.danger-solid { background: var(--danger); border-color: var(--danger); color: #1a0508; font-weight: 650; }

.scrim { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 40; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 41; background: var(--panel); border-top: 1px solid var(--line); border-radius: 18px 18px 0 0;
  padding: 8px 16px calc(16px + var(--safe-b)); max-height: 86vh; overflow-y: auto; animation: up .2s ease; }
@media (min-width: 700px) { .sheet { left: 50%; right: auto; width: 520px; transform: translateX(-50%); bottom: 20px; border-radius: 18px; border: 1px solid var(--line); animation: none; } }
@keyframes up { from { transform: translateY(40px); opacity: 0; } }
.grab { width: 40px; height: 4px; border-radius: 4px; background: #3a454d; margin: 2px auto 10px; }
.sheet h3 { margin: 0 0 2px; font-size: 17px; }
.sheet .sub { color: var(--muted); font-size: 13px; margin-bottom: 12px; }
.sheet .row { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0; }
.sheet .lbl { font-size: 11.5px; text-transform: uppercase; letter-spacing: .8px; color: var(--muted); font-weight: 700; margin: 14px 0 6px; }
.sheet .preview { width: 100%; max-height: 38vh; object-fit: contain; border-radius: 12px; background: #0b0f12; display: block; }
.sheet textarea, .sheet input[type=text] { width: 100%; background: var(--bg); color: var(--text); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font: inherit; font-size: 16px; resize: vertical; }
.sheet textarea:focus, .sheet input:focus { outline: none; border-color: var(--accent); }
.sheet .chip.cur { background: var(--accent); color: #07110d; border-color: var(--accent); font-weight: 650; }
.menu-list { display: flex; flex-direction: column; }
.menu-list button { display: flex; align-items: center; gap: 12px; text-align: left; background: none; border: 0; padding: 13px 4px; border-bottom: 1px solid var(--line); font-size: 15px; cursor: pointer; }
.menu-list button:last-child { border-bottom: 0; }
.menu-list button small { color: var(--muted); display: block; font-size: 12.5px; }
.menu-list svg { flex: none; color: var(--accent); }
.cat-row { display: flex; gap: 6px; align-items: center; margin-bottom: 6px; }
.cat-row input { flex: 1; }
.cat-row .n { color: var(--muted); font-size: 12px; min-width: 22px; text-align: right; }

.toast { position: fixed; left: 50%; bottom: calc(24px + var(--safe-b)); transform: translate(-50%, 20px); background: var(--panel); border: 1px solid var(--line);
  border-left: 3px solid var(--accent); padding: 10px 16px; border-radius: 10px; opacity: 0; transition: opacity .2s, transform .2s; pointer-events: none; z-index: 60;
  box-shadow: 0 10px 30px rgba(0,0,0,.5); font-size: 14px; max-width: 90vw; }
.toast.show { opacity: 1; transform: translate(-50%, 0); }
.toast.err { border-left-color: var(--danger); }
.ro.ok { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 50%, var(--line)); }
.ro { display: inline-block; font-size: 11px; border: 1px solid var(--line); border-radius: 999px; padding: 1px 7px; color: var(--muted); margin-left: 6px; vertical-align: 2px; }

@media (max-width: 480px) {
  .logo { display: none; }
  .tools { gap: 3px; }
  .ib { width: 38px; height: 38px; border-radius: 11px; }
  .bt h1 { font-size: 16px; white-space: nowrap; }
  .bt span { display: block; overflow: hidden; text-overflow: ellipsis; }
  .ro { margin-left: 0; margin-top: 2px; }
}

.banner a { color: var(--accent); }
.empty.signin { padding-top: 60px; }
.gbtn { display: inline-flex; align-items: center; gap: 10px; background: #fff; color: #1f1f1f; border: 0; border-radius: 999px; padding: 12px 22px; font-size: 16px; font-weight: 600; cursor: pointer; margin: 14px 0 8px; box-shadow: 0 2px 10px rgba(0,0,0,.35); }
.gbtn svg { width: 20px; height: 20px; stroke: none; }
.gbtn:active { transform: scale(.97); }
.muted { color: var(--muted); font-size: 13px; }

</style>
</head>
