<script>
// DeviantArt / wixmp URL helpers shared by the content script and background worker.
(function (root) {
  function decodeJwt(token) {
    try {
      let p = token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/");
      while (p.length % 4) p += "=";
      return JSON.parse(atob(p));
    } catch (e) {
      return null;
    }
  }

  function isWixmp(url) {
    return /(^|\.)wixmp\.com$/i.test(hostOf(url));
  }

  function hostOf(url) {
    try { return new URL(url).hostname; } catch (e) { return ""; }
  }

  // Splits a wixmp URL into the original-file path and the transform part (if any).
  // e.g. /f/<uuid>/<id>-<uuid>.png/v1/fill/w_400,h_300,q_70,strp/name-pre.jpg
  function parseWixmp(url) {
    let u;
    try { u = new URL(url); } catch (e) { return null; }
    if (!isWixmp(url)) return null;
    const m = u.pathname.match(/^(\/(?:intermediary\/)?[fi]\/[^/]+\/[^/]+?)(?:\/v1\/(fill|fit|crop)\/([^/]+)\/([^/]+))?$/);
    if (!m) return null;
    const params = {};
    if (m[3]) {
      for (const part of m[3].split(",")) {
        const i = part.indexOf("_");
        if (i < 0) params[part] = true;
        else params[part.slice(0, i)] = part.slice(i + 1);
      }
    }
    const extMatch = m[1].match(/\.([a-z0-9]+)$/i);
    return {
      origin: u.origin,
      base: m[1],
      op: m[2] || null,
      params,
      fname: m[4] || null,
      token: u.searchParams.get("token"),
      ext: extMatch ? extMatch[1].toLowerCase() : null
    };
  }

  // Returns the biggest, highest-quality version of a DeviantArt image URL that the
  // URL's own access token allows. Non-wixmp URLs are returned unchanged.
  function bestUrl(url) {
    const info = parseWixmp(url);
    if (!info || !info.op) return url; // not wixmp, or already the untransformed file

    if (!info.token) {
      // Old/unprotected files: the untransformed original is publicly reachable.
      return info.origin + info.base;
    }

    const payload = decodeJwt(info.token);
    const rule = payload && payload.obj && payload.obj[0] && payload.obj[0][0];
    const num = (v) => (v ? parseInt(String(v).replace(/[^\d]/g, ""), 10) : NaN);
    let maxW = rule ? num(rule.width) : NaN;
    let maxH = rule ? num(rule.height) : NaN;
    const curW = num(info.params.w);
    const curH = num(info.params.h);

    if (isNaN(maxW) && isNaN(maxH)) {
      // No size limit in the token: keep the size, just bump quality.
      if (isNaN(curW) || isNaN(curH)) return url;
      maxW = curW; maxH = curH;
    } else if (isNaN(maxH)) {
      if (info.op === "crop" || isNaN(curW) || isNaN(curH)) return url;
      maxH = Math.round((curH * maxW) / curW);
    } else if (isNaN(maxW)) {
      if (info.op === "crop" || isNaN(curW) || isNaN(curH)) return url;
      maxW = Math.round((curW * maxH) / curH);
    }

    let fname = info.fname || "image.jpg";
    fname = fname.replace(/-(?:pre|fullview|\d+[th]?)(\.[a-z0-9]+)$/i, "-fullview$1");
    // PNG originals can be served as PNG (lossless) instead of a JPEG re-encode.
    if (info.ext === "png") fname = fname.replace(/\.[a-z0-9]+$/i, ".png");
    if (info.ext === "gif") fname = fname.replace(/\.[a-z0-9]+$/i, ".gif");

    return `${info.origin}${info.base}/v1/fill/w_${maxW},h_${maxH},q_100/${fname}?token=${info.token}`;
  }

  // A smaller (but sharp) version for grids, e.g. ~500px wide. Falls back to the input URL.
  function resized(url, targetW) {
    const best = bestUrl(url);
    const m = best.match(/\/v1\/fill\/w_(\d+),h_(\d+),q_100\//);
    if (!m) return url;
    const w = +m[1], h = +m[2];
    if (w <= targetW) return best;
    const nh = Math.max(1, Math.round((h * targetW) / w));
    return best.replace(m[0], `/v1/fill/w_${targetW},h_${nh},q_85/`);
  }

  // Extension the downloaded file will have.
  function guessExt(url) {
    const info = parseWixmp(url);
    if (info) {
      if (info.fname) {
        const m = info.fname.match(/\.([a-z0-9]+)$/i);
        if (m) return m[1].toLowerCase();
      }
      if (info.ext) return info.ext;
    }
    const m = (url || "").split("?")[0].match(/\.([a-z0-9]{2,5})$/i);
    return m ? m[1].toLowerCase() : "jpg";
  }

  // Parses https://www.deviantart.com/<artist>/art/<slug>-<id>
  function parseDeviationUrl(href) {
    let u;
    try { u = new URL(href, "https://www.deviantart.com/"); } catch (e) { return null; }
    if (!/deviantart\.com$/i.test(u.hostname)) return null;
    let m = u.pathname.match(/^\/([^/]+)\/art\/(\d+)\/?$/);
    let slug = "";
    if (m) {
      m = [m[0], m[1], "", m[2]];
    } else {
      m = u.pathname.match(/^\/([^/]+)\/art\/(.+)-(\d+)\/?$/);
      if (!m) return null;
      slug = m[2];
    }
    const artist = decodeURIComponent(m[1]);
    const id = m[3];
    const title = slug ? decodeURIComponent(slug).replace(/-+$/, "").replace(/-/g, " ") : id;
    return { artist, id, title, url: u.origin + u.pathname };
  }

  function sanitize(part) {
    return String(part || "")
      .replace(/[\\/:*?"<>|\u0000-\u001f]+/g, " ")
      .replace(/\s{2,}/g, " ")
      .replace(/^[.\s]+|[.\s]+$/g, "")
      .slice(0, 120) || "untitled";
  }

  function buildFilename(template, meta, ext) {
    const tpl = (template || "DeviantArt/{artist}/{title} - {id}").trim();
    const segments = tpl.split("/").map((seg) =>
      sanitize(seg.replace(/\{(artist|title|id|date)\}/g, (_, k) => {
        if (k === "date") return new Date().toISOString().slice(0, 10);
        return meta && meta[k] ? meta[k] : (k === "id" ? "" : "unknown");
      }).replace(/\s+-\s*$/, ""))
    );
    return segments.join("/") + "." + (ext || "jpg");
  }

  root.BDA_URL = { decodeJwt, isWixmp, parseWixmp, bestUrl, resized, guessExt, parseDeviationUrl, buildFilename, sanitize };
})(typeof self !== "undefined" ? self : this);

;
// Quick tags + smart search, shared by the extension pages, the content script and the phone/tablet web app.
// Typing "horse" finds deviations whose tags, title, artist, category or note contain a word starting
// with "horse" (so "horses", "horseback" match too). "#horse" looks only at tags.
(function (root) {
  const norm = (t) => String(t || "").replace(/^#+/, "").trim().toLowerCase().replace(/\s+/g, " ").slice(0, 40);

  function parse(text) {
    const out = [];
    for (const part of String(text || "").split(/[,#\n]+/)) {
      const t = norm(part);
      if (t && !out.includes(t)) out.push(t);
    }
