<header class="top">
  <div class="brand">
    <div class="logo">B<span>✦</span></div>
    <div class="bt"><h1>My Library</h1><span id="count">…</span></div>
  </div>
  <div class="tools">
    <button class="ib" id="addBtn" aria-label="Add your own images" hidden><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button>
    <button class="ib" id="searchBtn" aria-label="Search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></button>
